    },\\n            \\\"JSONnodeData\\\": \\\"{}\\\"\\n        }\\n    ],\\n   
    \\\"m_SurfaceType\\\": 1,\\n    \\\"m_AlphaMode\\\": 0,\\n    \\\"m_TwoSided\\\":
